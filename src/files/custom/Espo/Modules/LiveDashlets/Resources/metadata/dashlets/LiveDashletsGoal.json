{
    "view": "live-dashlets:views/dashlets/goal",
    "options": {
        "view": "live-dashlets:views/dashlets/options/metric",
        "fields": {
            "title": {
                "type": "varchar",
                "required": true
            },
            "autorefreshInterval": {
                "type": "enumFloat",
                "options": [
                    0,
                    0.5,
                    1,
                    2,
                    5,
                    10
                ]
            },
            "entityType": {
                "type": "enum",
                "required": true,
                "view": "live-dashlets:views/dashlets/fields/entity-type"
            },
            "metric": {
                "type": "enum",
                "options": [
                    "count",
                    "sum",
                    "avg"
                ],
                "default": "count",
                "translation": "DashletOptions.options.metric"
            },
            "valueField": {
                "type": "enum",
                "view": "live-dashlets:views/dashlets/fields/value-field"
            },
            "primaryFilter": {
                "type": "enum",
                "view": "views/dashlets/fields/records/primary-filter"
            },
            "boolFilterList": {
                "type": "multiEnum",
                "view": "views/dashlets/fields/records/bool-filter-list"
            },
            "period": {
                "type": "enum",
                "options": [
                    "today",
                    "currentWeek",
                    "currentMonth",
                    "currentQuarter",
                    "currentYear",
                    "currentFiscalQuarter",
                    "currentFiscalYear",
                    "lastSevenDays",
                    "lastThirtyDays",
                    "ever"
                ],
                "translation": "LiveDashlets.periods"
            },
            "dateField": {
                "type": "enum",
                "view": "live-dashlets:views/dashlets/fields/date-field",
                "tooltip": true
            },
            "accentColor": {
                "type": "enum",
                "options": [
                    "primary",
                    "success",
                    "info",
                    "warning",
                    "danger",
                    "default"
                ],
                "translation": "DashletOptions.options.accentColor"
            },
            "target": {
                "type": "float",
                "required": true,
                "min": 0
            },
            "tileStyle": {
                "type": "enum",
                "options": [
                    "soft",
                    "minimal",
                    "solid"
                ],
                "translation": "DashletOptions.options.tileStyle"
            }
        },
        "defaults": {
            "metric": "count",
            "period": "currentMonth",
            "accentColor": "success",
            "boolFilterList": [],
            "autorefreshInterval": 0,
            "tileStyle": "soft"
        },
        "layout": [
            {
                "rows": [
                    [
                        {
                            "name": "title"
                        },
                        {
                            "name": "accentColor"
                        }
                    ],
                    [
                        {
                            "name": "tileStyle"
                        },
                        false
                    ],
                    [
                        {
                            "name": "entityType"
                        },
                        {
                            "name": "primaryFilter"
                        }
                    ],
                    [
                        {
                            "name": "boolFilterList"
                        },
                        false
                    ],
                    [
                        {
                            "name": "metric"
                        },
                        {
                            "name": "valueField"
                        }
                    ],
                    [
                        {
                            "name": "target"
                        },
                        false
                    ],
                    [
                        {
                            "name": "period"
                        },
                        {
                            "name": "dateField"
                        }
                    ],
                    [
                        {
                            "name": "autorefreshInterval"
                        },
                        false
                    ]
                ]
            }
        ]
    }
}
